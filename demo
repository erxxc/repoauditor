#!/bin/sh
set -eu

if [ -x ".venv/bin/repoauditor" ]; then
  exec .venv/bin/repoauditor demo "$@"
fi

if ! command -v uv >/dev/null 2>&1; then
  echo "repoauditor demo needs uv."
  echo "macOS: brew install uv"
  echo "Other systems: https://docs.astral.sh/uv/getting-started/installation/"
  exit 1
fi

exec uv run repoauditor demo "$@"
